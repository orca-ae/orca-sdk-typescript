# Orca SDK — Integration test environment variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.

# Set both to run the integration suite, or neither to skip it; one alone fails.
# Export them before running it: set -a; . ./.env.local; set +a
ORCA_TEST_API_KEY=
ORCA_TEST_BASE_URL=https://your-orca-deployment.example.com
